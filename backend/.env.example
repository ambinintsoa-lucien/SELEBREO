# Copier ce fichier en .env et remplir les vraies valeurs (jamais commiter .env)

DATABASE_URL="postgresql://selebreo:selebreo@localhost:5432/selebreo_dev"

PORT=4000

# Secret JWT — générer une vraie valeur aléatoire longue pour la prod
JWT_SECRET="change_me_dev_secret_only"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="30d"

# Stockage vidéo (S3 ou compatible, ex. Cloudflare R2) — à remplir plus tard
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Paramètres classement par défaut (une CompetitionPeriod peut les surcharger en base)
RANKING_INITIAL_STAGE_DELAY_DAYS=7
RANKING_STAGE_REDUCTION_DELAY_DAYS=30

# CORS — origine autorisée du frontend en dev
CORS_ORIGIN="http://localhost:5173"
